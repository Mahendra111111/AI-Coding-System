{
  "name": "ai-coding-system",
  "version": "1.0.0",
  "description": "Local MCP server for shared AI coding project context across editors",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai-coding-mcp": "dist/index.js",
    "acs-doctor": "dist/cli/doctor.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/doctor.ts",
    "setup": "powershell -ExecutionPolicy Bypass -File ./install.ps1",
    "von:serve": "powershell -ExecutionPolicy Bypass -File ./scripts/start-von.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "ai-coding",
    "context",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "next-seo": "^7.3.0",
    "von-sdk": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.0.9"
  }
}
